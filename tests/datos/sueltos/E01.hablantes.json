 "frases": [
  {
   "sp": 0,
   "start": 0.5,
   "end": 2.48,
   "text": "Buenas tardes, gracias por recibirme."
  },
  {
   "sp": 1,
   "start": 3.08,
   "end": 4.36,
   "text": "Con gusto, pase adelante."
  },
  {
   "sp": 0,
   "start": 4.96,
   "end": 8.35,
   "text": "Para empezar, ¿me confirma que usted es Ana Inventada Muñoz?"
  },
  {
   "sp": 1,
   "start": 8.95,
   "end": 11.02,
   "text": "Sí, Ana Inventada Muñoz, para servirle."
  },
  {
   "sp": 0,
   "start": 11.62,
   "end": 13.56,
   "text": "¿Cuánto tiempo tiene de vivir en este barrio?"
  },
  {
   "sp": 1,
   "start": 14.16,
   "end": 16.91,
   "text": "Ya van a ser doce años. Llegué cuando nació mi hija."
  },
  {
   "sp": 0,
   "start": 17.51,
   "end": 19.58,
   "text": "¿Cómo se siente al caminar por aquí en la noche?"
  },
  {
   "sp": 1,
   "start": 20.18,
   "end": 23.44,
   "text": "Depende de la calle. Por la avenida principal me siento tranquila."
  },
  {
   "sp": 0,
   "start": 24.04,
   "end": 25.23,
   "text": "¿Y por las calles de atrás?"
  },
  {
   "sp": 1,
   "start": 25.82,
   "end": 29.23,
   "text": "Ahí no tanto. Hay poca luz y casi nadie pasa después de las ocho."
  },
  {
   "sp": 0,
   "start": 29.83,
   "end": 31.31,
   "text": "¿Ha cambiado eso con los años?"
  },
  {
   "sp": 1,
   "start": 31.91,
   "end": 32.4,
   "text": "Sí, claro."
  },
  {
   "sp": 1,
   "start": 34.2,
   "end": 34.67,
   "text": "Sí, claro."
  },
  {
   "sp": 0,
   "start": 35.27,
   "end": 36.36,
   "text": "¿Qué cambió exactamente?"
  },
  {
   "sp": 1,
   "start": 36.96,
   "end": 39.75,
   "text": "Cerraron la pulpería de la esquina y la parada quedó sola."
  },
  {
   "sp": 0,
   "start": 40.35,
   "end": 42.26,
   "text": "¿Qué hace usted para sentirse más segura?"
  },
  {
   "sp": 1,
   "start": 42.86,
   "end": 45.41,
   "text": "Camino con el teléfono en la mano y aviso cuando salgo."
  },
  {
   "sp": 0,
   "start": 46.01,
   "end": 46.78,
   "text": "¿A quién le avisa?"
  },
  {
   "sp": 1,
   "start": 47.38,
   "end": 49.52,
   "text": "A mi vecina. Nos escribimos por mensaje."
  },
  {
   "sp": 0,
   "start": 50.12,
   "end": 51.77,
   "text": "¿Hay algún lugar que evite por completo?"
  },
  {
   "sp": 1,
   "start": 52.37,
   "end": 54.38,
   "text": "El puente del río. De noche no paso por ahí."
  },
  {
   "sp": 0,
   "start": 54.98,
   "end": 56.53,
   "text": "¿Qué cambiaría primero si pudiera?"
  },
  {
   "sp": 1,
   "start": 57.13,
   "end": 59.36,
   "text": "Más luz en las aceras y que la parada tenga techo."
  },
  {
   "sp": 0,
   "start": 59.96,
   "end": 62.0,
   "text": "Muchas gracias por su tiempo, doña Ana."
  },
  {
   "sp": 1,
   "start": 62.6,
   "end": 63.66,
   "text": "A usted, que le vaya bien."
  }
 ]
