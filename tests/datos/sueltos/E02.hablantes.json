 "frases": [
  {
   "sp": 1,
   "start": 0.5,
   "end": 2.6,
   "text": "Buenas noches, ¿tiene un minuto para conversar?"
  },
  {
   "sp": 0,
   "start": 3.2,
   "end": 4.74,
   "text": "Sí, un ratito, voy para la parada."
  },
  {
   "sp": 1,
   "start": 5.34,
   "end": 6.61,
   "text": "¿Me dice su nombre, por favor?"
  },
  {
   "sp": 0,
   "start": 7.21,
   "end": 8.35,
   "text": "Bruno Ficticio Ramírez."
  },
  {
   "sp": 1,
   "start": 8.95,
   "end": 10.3,
   "text": "¿Toma el bus aquí todos los días?"
  },
  {
   "sp": 0,
   "start": 10.9,
   "end": 12.53,
   "text": "De lunes a viernes, a las seis y media."
  },
  {
   "sp": 1,
   "start": 13.13,
   "end": 14.79,
   "text": "¿Cómo se siente esperando a esa hora?"
  },
  {
   "sp": 0,
   "start": 15.39,
   "end": 18.05,
   "text": "Incómodo. La parada está oscura y uno no ve quién viene."
  },
  {
   "sp": 1,
   "start": 18.66,
   "end": 19.81,
   "text": "¿Ha tenido algún problema?"
  },
  {
   "sp": 0,
   "start": 20.41,
   "end": 23.46,
   "text": "A mí no, pero a un compañero le quitaron el teléfono el mes pasado."
  },
  {
   "sp": 1,
   "start": 24.06,
   "end": 26.41,
   "text": "Gracias, don Bruno. Que tenga buen viaje."
  },
  {
   "sp": 0,
   "start": 27.01,
   "end": 28.13,
   "text": "Gracias, igualmente."
  }
